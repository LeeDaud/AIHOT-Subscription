{
  "name": "aihot-mail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/web/views dist/web/",
    "start": "node dist/index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop aihot-mail",
    "pm2:restart": "pm2 restart aihot-mail",
    "pm2:logs": "pm2 logs aihot-mail",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.0",
    "ejs": "^3.1.9",
    "express": "^4.19.0",
    "express-basic-auth": "^1.2.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
