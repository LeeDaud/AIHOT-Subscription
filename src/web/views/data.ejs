<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>AIHOT Mail · <%= type %> Data</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; background: #f0f2f5; color: #333; padding: 24px; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .header h1 { font-size: 20px; }
    .header h1 span { color: #e94560; }
    .nav a { color: #1a73e8; text-decoration: none; font-size: 13px; margin-left: 12px; }
    .info { font-size: 12px; color: #888; margin-bottom: 12px; }
    pre { background: #1e1e2e; color: #cdd6f4; padding: 16px; border-radius: 8px; font-size: 12px; line-height: 1.6; overflow-x: auto; white-space: pre-wrap; word-break: break-all; }
  </style>
</head>
<body>
  <div class="header">
    <h1>AI <span>HOT</span> Mail · <%= type %> 数据</h1>
    <div class="nav"><a href="/">← 返回仪表盘</a></div>
  </div>
  <div class="info">缓存 Key: <code><%= key %></code></div>
  <pre><%= data %></pre>
</body>
</html>
